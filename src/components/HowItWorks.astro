---
import Icon from './Icon.astro';
import { steps } from '../data/site';
---

<section id="proceso" class="section">
  <div class="shell">
    <div class="max-w-copy" data-reveal>
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 class="mt-6 text-3xl font-bold text-slate-900 sm:text-4xl">
        De tu mensaje a la tarima tratada en tres pasos
      </h2>
    </div>

    <ol class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        steps.map((step, index) => (
          <li
            class="rounded-2xl border border-slate-200 bg-white p-6 transition-all duration-700 ease-fluid hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/5"
            data-reveal
            style={`transition-delay: ${index * 50}ms`}
          >
            <span class="grid size-12 place-items-center rounded-xl bg-slate-900 text-base font-bold text-orange-500">
              {index + 1}
            </span>
            <h3 class="mt-6 text-xl font-bold text-slate-900">{step.title}</h3>
            <p class="mt-3 text-base text-slate-700">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p
      class="mt-8 flex flex-wrap items-center gap-2 text-sm text-slate-700"
      data-reveal
    >
      <Icon name="shield-check" class="size-4 text-orange-600" />
      <span class="font-semibold text-slate-900">Garantía de reposición:</span>
      si una tarima del lote falla por fabricación, la reponemos sin costo dentro de los 90 días
      siguientes a la entrega.
    </p>
  </div>
</section>
