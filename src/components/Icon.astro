---
import { phosphorIcons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
}

const { name, class: className = 'size-6', size } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  fill="currentColor"
  class={className}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  set:html={phosphorIcons[name]}
/>
