---
import Icon from './Icon.astro';
import { certifications, stats } from '../data/site';
---

<section class="bg-slate-900 pt-8 pb-16" aria-label="Datos de operación">
  <div class="shell" data-reveal>
    <ul class="grid gap-8 border-t border-slate-700 pt-8 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <li>
            <p class="text-3xl font-bold text-white">{stat.value}</p>
            <p class="mt-2 text-sm text-slate-400">{stat.label}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <p class="flex items-center gap-2 text-sm font-semibold text-slate-300">
        <Icon name="medal" class="size-4 text-orange-500" />
        Certificaciones vigentes
      </p>
      {
        certifications.map((item) => (
          <span class="rounded-full border border-slate-700 px-3 py-2 text-xs font-semibold text-slate-300">
            {item}
          </span>
        ))
      }
    </div>
  </div>
</section>
