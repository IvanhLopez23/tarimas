---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Vision from '../components/Vision.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import Contact from '../components/Contact.astro';
import { faq, products, site } from '../data/site';

const title = 'Tarimas de exportación y distribución nacional e internacional';
const description = site.description;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: site.name,
    legalName: site.legalName,
    url: site.url,
    telephone: site.phone.display,
    email: site.email,
    description: site.description,
    image: `${site.url}/images/og-cover.svg`,
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.state,
      postalCode: site.address.zip,
      addressCountry: 'MX',
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '08:00',
        closes: '18:00',
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Saturday'],
        opens: '08:00',
        closes: '13:00',
      },
    ],
    sameAs: site.social.map((item) => item.href),
    makesOffer: products.map((product) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Product',
        name: product.name,
        description: product.summary,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <Hero />
  <ProofStrip />
  <Vision />
  <ProductCarousel />
  <TaglineReveal lines={['Ningún contenedor se detiene', 'por una tarima mal tratada.']} />
  <HowItWorks />
  <Faq />
  <QuoteBanner />
  <Contact />
</BaseLayout>
